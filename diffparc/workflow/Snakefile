import snakebids
from snakebids import bids


configfile: "config/snakebids.yml"

report: "../workflow/report/workflow.rst"

# -----------------------------
# Config defaults
# -----------------------------
# Workflow mode
config.setdefault("anat_only", False)
config.setdefault("no_vol", False)

# DWI source: import (snakedwi/prepdwi) vs raw-DWI preprocessing below
config.setdefault("in_prepdwi_dir", False)
config.setdefault("in_snakedwi_dir", False)
config.setdefault("dwi_biascorrect", False)   # native bias-correction; off when snakedwi drives it

# Raw-DWI preprocessing (only used when not importing)
config.setdefault("use_eddy", False)
config.setdefault("use_topup", False)
config.setdefault("eddy_no_s2v", False)
config.setdefault("slspec_txt", False)
config.setdefault("masking_method", "b0_BET")
config.setdefault("b0_bet_frac", 0.5)
config.setdefault("eddy", {
    "flags": {
        "verbose": True,
        "repol": True,
        "cnr_maps": True,
        "residuals": True,
        "data_is_shelled": True,
    },
    "with_s2v": {
        "mporder": 6,
        "s2v_niter": 5,
        "s2v_lambda": 1,
        "s2v_interp": "trilinear",
        "ol_type": "both",
    },
    "without_s2v": {
        "ol_type": "sw",
    },
})

# Outputs / experiments
config.setdefault("connectivity_variants", {})   # absent => only baseline raw + mu-scaled
config.setdefault("mask_sweep", {})
config["mask_sweep"].setdefault("enabled", False)
config.setdefault("show_parallel_eta", False)

# -----------------------------
# HPC / cluster portability
# -----------------------------
# Override container and scratch paths from the environment without editing tracked
# config. DIFFPARC_TMPDIR must be a SHARED filesystem (not node-local $SLURM_TMPDIR),
# since temp tractograms are tracked across grouped jobs.
import os as _os

if _os.environ.get("DIFFPARC_CONTAINER"):
    config.setdefault("singularity", {})
    config["singularity"]["diffparc"] = _os.environ["DIFFPARC_CONTAINER"]

if _os.environ.get("DIFFPARC_TMPDIR"):
    config["tmp_dir"] = _os.environ["DIFFPARC_TMPDIR"]

# -----------------------------
# Basic config normalization
# -----------------------------
if config.get("anat_only", False):
    del config["pybids_inputs"]["dwi"]


# -----------------------------
# Snakebids input generation
# -----------------------------
inputs = snakebids.generate_inputs(
    bids_dir=config["bids_dir"],
    pybids_inputs=config["pybids_inputs"],
    pybids_database_dir=config.get("pybids_db_dir"),
    pybids_reset_database=config.get("pybids_db_reset"),
    derivatives=config["derivatives"],
    participant_label=config["participant_label"],
    exclude_participant_label=config["exclude_participant_label"],
    use_bids_inputs=True,
)


wildcard_constraints:
    **snakebids.get_wildcard_constraints(config["pybids_inputs"]),
    seed="[a-zA-Z0-9]+",
    hemi="L|R",
    targets="[a-zA-Z0-9]+",


subj_wildcards = inputs.subj_wildcards
input_wildcards = inputs.input_wildcards
input_zip_lists = inputs.input_zip_lists
input_path = inputs.input_path

root = config["root"]


# -----------------------------
# Build subject/session zip list
# Only keep subject/session combos
# present across all required inputs
# -----------------------------
subj_set_intersection = None
subj_zip_list = None

for bidsinput in config["pybids_inputs"].keys():
    zipl = inputs.input_zip_lists[bidsinput]

    if "session" in zipl:
        subj_set = set(zip(zipl["subject"], zipl["session"]))
    else:
        subj_set = set(zipl["subject"])

    subj_set_intersection = (
        subj_set
        if subj_set_intersection is None
        else subj_set.intersection(subj_set_intersection)
    )

if subj_set_intersection is None:
    raise ValueError("No valid BIDS inputs found.")

if "session" in zipl:
    if len(subj_set_intersection) == 0:
        subj_zip_list = {"subject": [], "session": []}
    else:
        subzip, seszip = zip(*list(subj_set_intersection))
        subj_zip_list = {
            "subject": list(subzip),
            "session": list(seszip),
        }
else:
    subj_zip_list = {"subject": list(subj_set_intersection)}


# -----------------------------
# Connectivity matrix variants (config: connectivity_variants)
# -----------------------------
# Registry shared verbatim with rules/connectivity.smk AND rules/mask_sweep.smk
# (mirrored naming). Each corrected variant maps a `meas-` filename tag to a
# tck2connectome edge-scaling recipe (+/- SIFT2 mu). Length bias uses -scale_length
# (UP-weights longer streamlines, NOT -scale_invlength); volume bias uses
# -scale_invnodevol. raw + mu-scaled are the baselines from the core rule.
#   meas tag              -> tck2connectome scale flags                   mu (SIFT2)
CONN_VARIANT_RECIPES = {
    "invnodevol":          {"scale": "-scale_invnodevol",               "mu": 0},
    "length":              {"scale": "-scale_length",                   "mu": 0},
    "invnodevollength":    {"scale": "-scale_invnodevol -scale_length", "mu": 0},
    "invnodevollengthmu":  {"scale": "-scale_invnodevol -scale_length", "mu": 1},
}
# config key -> meas tag (dict order defines the target-expansion order).
CONN_VARIANT_KEYS = {
    "volume_bias_corrected":                  "invnodevol",
    "length_bias_corrected":                  "length",
    "volume_length_bias_corrected":           "invnodevollength",
    "volume_length_bias_corrected_mu_scaled": "invnodevollengthmu",
}
# Regex alternation constraining the {meas} wildcard on the variant rules, so they
# never capture the baseline meas-muscaled block written by the core connectome rules.
CONN_VARIANT_MEAS_CONSTRAINT = "|".join(CONN_VARIANT_RECIPES.keys())


def conn_variant_meas_enabled():
    """The `meas` tags of the four corrected variants enabled in config."""
    cfg = config.get("connectivity_variants", {})
    return [meas for key, meas in CONN_VARIANT_KEYS.items() if cfg.get(key, False)]


# -----------------------------
# Final target helpers
# -----------------------------
def get_subj_global_conn_sift2():
    files = []

    if config["no_vol"] or not config.get("enable_global_conn", False):
        return []

    for seed in config["select_seeds"]:
        files.extend(
            expand(
                expand(
                    bids(
                        root=root,
                        datatype="tracts",
                        hemi="{hemi}",
                        desc="{targets}",
                        label="{seed}",
                        suffix="connectivity_matrix.csv",
                        **subj_wildcards,
                    ),
                    seed=seed,
                    targets=config["seeds"][seed]["targets"],
                    hemi=config["hemispheres"],
                    allow_missing=True,
                ),
                zip,
                **subj_zip_list,
            )
        )

    return files


def get_connectivity_variant_outputs():
    # Additive, config-gated connectivity-matrix variants for the MAIN seed-filtered
    # tractogram (rules/connectivity.smk: connectivity_variant). Same gating as the
    # baseline global-conn matrices (no_vol / enable_global_conn). raw + mu-scaled
    # stay as the baseline outputs above; only the four corrected variants are added.
    if config["no_vol"] or not config.get("enable_global_conn", False):
        return []

    meas = conn_variant_meas_enabled()
    if not meas:
        return []

    files = []
    for seed in config["select_seeds"]:
        files.extend(
            expand(
                expand(
                    "sub-{subject}/tracts/"
                    "sub-{subject}_hemi-{hemi}_label-{seed}_desc-{targets}"
                    "_meas-{meas}_connectivity_matrix.csv",
                    seed=seed,
                    targets=config["seeds"][seed]["targets"],
                    hemi=config["hemispheres"],
                    meas=meas,
                    allow_missing=True,
                ),
                zip,
                **subj_zip_list,
            )
        )

    return files


def get_mask_sweep_outputs():
    if not config.get("mask_sweep", {}).get("enabled", False):
        return []

    subjects = sorted(set(inputs.input_zip_lists["T1w"]["subject"]))
    mask_sources = config["mask_sweep"].get("mask_sources", ["native"])
    thresholds = config["mask_sweep"].get("thresholds", [])
    thr_tags = [str(t).replace(".", "p") for t in thresholds]
    # keep seeds/targets in sync with SWEEP_SEEDS/TARGETS in rules/mask_sweep.smk
    seeds = ["vtasnc", "snc", "vtapbp", "vtasncpbp"]
    hemis = ["L", "R"]
    targets = ["Yeo7TianS3"]

    common = dict(
        subject=subjects,
        mask_source=mask_sources,
        hemi=hemis,
        seed=seeds,
        targets=targets,
        thr_tag=thr_tags,
    )

    # Baseline (mu-scaled) matrices -- unchanged.
    files = expand(
        "sub-{subject}/tracts/mask_sweep/{seed}/{mask_source}/"
        "sub-{subject}_hemi-{hemi}_label-{seed}_thr-{thr_tag}_desc-{targets}_connectivity_matrix.csv",
        **common,
    )

    # Corrected connectivity-matrix variants (config connectivity_variants), named
    # identically to the main matrices (rules/mask_sweep.smk: sweep_connectivity_variant).
    meas = conn_variant_meas_enabled()
    if meas:
        files += expand(
            "sub-{subject}/tracts/mask_sweep/{seed}/{mask_source}/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_thr-{thr_tag}_desc-{targets}"
            "_meas-{meas}_connectivity_matrix.csv",
            meas=meas,
            **common,
        )

    # Tractography visual QC for each sweep seed-filtered tractogram, mirroring the
    # main pipeline (rules/mask_sweep.smk: sweep_qc_tractogram_filtered). Organized
    # under thr-{thr_tag}/tractogram/. Gated by tractography_qc. The visual QC is
    # variant-independent (one tractogram per threshold), so it has no {targets} tag.
    if config.get("tractography_qc", True):
        arts = ["tdi.mif", "endpoints.mif", "decmap.mif", "subset.tck",
                "lengths.csv", "lengths.png"]
        files += expand(
            "sub-{subject}/qc/mask_sweep/{seed}/{mask_source}/thr-{thr_tag}/tractogram/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_thr-{thr_tag}_desc-seedfiltered_{art}",
            subject=subjects,
            mask_source=mask_sources,
            hemi=hemis,
            seed=seeds,
            thr_tag=thr_tags,
            art=arts,
        )

    return files


def get_enrichment_sweep_outputs():
    # Single entry point for the isolated enrichment_sweep module (rules/enrichment_sweep.smk).
    if config.get("anat_only", False):
        return []
    es = config.get("enrichment_sweep", {})
    if not es.get("enabled", False):
        return []

    subjects = sorted(set(inputs.input_zip_lists["T1w"]["subject"]))
    seed = es.get("seed", "vtasncpbp")
    hemis = es.get("hemis", ["L", "R"])
    targets = es.get("targets", ["Yeo7TianS3"])
    conds = ["wb"] + [str(int(lv)) for lv in es.get("levels", [])]

    # Per-subject metrics summary (mu/cost/counts).
    summaries = expand(
        "sub-{subject}/qc/enrichment_sweep/"
        "sub-{subject}_label-{seed}_enrichment_sweep_summary.csv",
        subject=subjects,
        seed=seed,
    )

    # Voxelwise connectivity fingerprint per condition x hemi (same as main pipeline).
    fingerprints = expand(
        "sub-{subject}/tracts/enrichment_sweep/cond-{cond}/"
        "sub-{subject}_hemi-{hemi}_label-{seed}_cond-{cond}_desc-{targets}_connectivity_matrix.csv",
        subject=subjects,
        seed=seed,
        hemi=hemis,
        cond=conds,
        targets=targets,
    )

    # Optional volume-bias-corrected fingerprint (tck2connectome -scale_invnodevol),
    # emitted in addition to the uncorrected one when the switch is on.
    fingerprints_invnodevol = []
    if es.get("volume_bias_correction", False):
        fingerprints_invnodevol = expand(
            "sub-{subject}/tracts/enrichment_sweep/cond-{cond}/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_cond-{cond}"
            "_scale-invnodevol_desc-{targets}_connectivity_matrix.csv",
            subject=subjects,
            seed=seed,
            hemi=hemis,
            cond=conds,
            targets=targets,
        )

    # Optional second SIFT2 branch ("propagated"): same conditions, but weights
    # fit once on the maximal tractogram and carried down the nested subsample.
    # Adds its own volume-bias-corrected variant when both switches are on.
    fingerprints_propagated = []
    if es.get("sift2_propagated", False):
        fingerprints_propagated = expand(
            "sub-{subject}/tracts/enrichment_sweep/cond-{cond}/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_cond-{cond}"
            "_sift2-propagated_desc-{targets}_connectivity_matrix.csv",
            subject=subjects,
            seed=seed,
            hemi=hemis,
            cond=conds,
            targets=targets,
        )
        if es.get("volume_bias_correction", False):
            fingerprints_propagated += expand(
                "sub-{subject}/tracts/enrichment_sweep/cond-{cond}/"
                "sub-{subject}_hemi-{hemi}_label-{seed}_cond-{cond}"
                "_sift2-propagated_scale-invnodevol_desc-{targets}_connectivity_matrix.csv",
                subject=subjects,
                seed=seed,
                hemi=hemis,
                cond=conds,
                targets=targets,
            )

    # Tractography visual QC (gated by tractography_qc): WB baseline + every
    # condition's seed-filtered tractogram, plus the per-subject FOD DEC background.
    qc = []
    if config.get("tractography_qc", True):
        arts = ["tdi.mif", "endpoints.mif", "decmap.mif", "subset.tck",
                "lengths.csv", "lengths.png"]
        # WB baseline keeps ONLY the trivial subset (rule enrich_qc_tractogram_wb):
        # its full density maps + length histogram over the ~100M WB tractogram were
        # dropped as an expensive single-core straggler. Filtered QC keeps all arts.
        qc += expand(
            "sub-{subject}/qc/enrichment_sweep/cond-wb/tractogram/"
            "sub-{subject}_label-{seed}_desc-wb_{art}",
            subject=subjects, seed=seed, art=["subset.tck"],
        )
        qc += expand(
            "sub-{subject}/qc/enrichment_sweep/cond-{cond}/tractogram/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_cond-{cond}_desc-seedfiltered_{art}",
            subject=subjects, seed=seed, hemi=hemis, cond=conds, art=arts,
        )
        qc += expand(
            "sub-{subject}/qc/connectivity/sub-{subject}_desc-fod_decmap.mif",
            subject=subjects,
        )

    return summaries + fingerprints + fingerprints_invnodevol + fingerprints_propagated + qc


def get_tractography_qc_outputs():
    # Visual QC for the whole-brain (final) and seed-filtered tractograms in the
    # core connectivity pipeline (rules.qc_tractogram_wb / qc_tractogram_filtered /
    # fod2dec). Gated by config tractography_qc; needs the DWI tractography stack.
    if config.get("anat_only", False) or config.get("no_vol", False):
        return []
    if not config.get("tractography_qc", True):
        return []

    subjects = sorted(set(inputs.input_zip_lists["T1w"]["subject"]))
    arts = ["tdi.mif", "endpoints.mif", "decmap.mif", "subset.tck",
            "lengths.csv", "lengths.png"]

    # Per subject: whole-brain (final) tractogram QC + FOD DEC background.
    files = expand(
        "sub-{subject}/qc/connectivity/sub-{subject}_desc-final_{art}",
        subject=subjects, art=arts,
    )
    files += expand(
        "sub-{subject}/qc/connectivity/sub-{subject}_desc-fod_decmap.mif",
        subject=subjects,
    )
    # Per seed x hemi: seed-filtered tractogram QC.
    for seed in config["select_seeds"]:
        files += expand(
            "sub-{subject}/qc/connectivity/"
            "sub-{subject}_hemi-{hemi}_label-{seed}_desc-seedfiltered_{art}",
            subject=subjects, hemi=config["hemispheres"], seed=seed, art=arts,
        )
    return files


def get_microstructure_connectome_outputs():
    # FA/MD/RD-weighted atlas connectomes for the whole-brain (final) tractogram
    # (rules/microstructure_connectomes.smk). Optional, additive, MAIN pipeline only.
    if config.get("anat_only", False) or config.get("no_vol", False):
        return []
    if not config.get("microstructure_connectomes", False):
        return []

    subjects = sorted(set(inputs.input_zip_lists["T1w"]["subject"]))
    targets = config.get("microstructure_connectomes_targets", ["Yeo7TianS3"])
    metrics = config.get("microstructure_connectomes_metrics", ["FA", "MD", "RD"])
    return expand(
        "sub-{subject}/tracts/"
        "sub-{subject}_desc-{targets}_meas-{metric}_connectivity_matrix.csv",
        subject=subjects, targets=targets, metric=metrics,
    )

rule all:
    input:
        get_subj_global_conn_sift2(),
        get_connectivity_variant_outputs(),
        get_mask_sweep_outputs(),
        get_enrichment_sweep_outputs(),
        get_tractography_qc_outputs(),
        get_microstructure_connectome_outputs()
    default_target: True


